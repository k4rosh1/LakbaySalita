    specificCharacter: 0
    characterLine: []
    isQuestion: 0
    choices:
    - 
    - 
    - 
    - 
    correctAnswerIndex: 0
    difficultyLevel: 1
    isFinalEnemy: 0
    voiceClip: {fileID: 8300000, guid: 8606ead8ded0cbb45a3c3bce4f969a02, type: 3}
    characterVoiceClips: []
  - line: 'May malakas na pagaspas ng pakpak na maririnig mula sa itaas.

'
